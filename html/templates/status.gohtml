<div class="card-grid">
    <article class="card">
        <h2 class="card-header">Connection Status</h2>
        <div class="status-list">
            <div class="status-item">
                <span class="status-label">Network State:</span>
                <span class="status-value {{if or (eq .NetworkInfo.State "connected") (eq .NetworkInfo.State "Connected")}}status-connected{{else if or (eq .NetworkInfo.State "disconnected") (eq .NetworkInfo.State "Disconnected")}}status-disconnected{{else}}status-limited{{end}}">
                    {{.NetworkInfo.State}}
                </span>
            </div>
            
            <div class="status-item">
                <span class="status-label">Connectivity:</span>
                <span class="status-value {{if or (eq .NetworkInfo.Connectivity "full") (eq .NetworkInfo.Connectivity "Full")}}status-connected{{else if or (eq .NetworkInfo.Connectivity "limited") (eq .NetworkInfo.Connectivity "Limited")}}status-limited{{else}}status-disconnected{{end}}">
                    {{.NetworkInfo.Connectivity}}
                </span>
            </div>
            
            <div class="status-item">
                <span class="status-label">WiFi:</span>
                <span class="status-value {{if or (eq .NetworkInfo.Wifi "enabled") (eq .NetworkInfo.Wifi "Enabled")}}status-enabled{{else}}status-disabled{{end}}">
                    {{.NetworkInfo.Wifi}}
                </span>
            </div>
        </div>
    </article>

    <article class="card">
        <h2 class="card-header">Device Information</h2>
        <div class="status-list">
            {{if .NetworkInfo.IPs.WifiIP}}
            <div class="status-item">
                <span class="status-label">Device IP:</span>
                <span class="status-value">{{.NetworkInfo.IPs.WifiIP}}{{if .NetworkInfo.WifiSSID}} ({{.NetworkInfo.WifiSSID}}){{end}}</span>
            </div>
            {{end}}
            
            {{if .NetworkInfo.WifiSSID}}
            <div class="status-item">
                <span class="status-label">Connected To:</span>
                <span class="status-value">{{.NetworkInfo.WifiSSID}}</span>
            </div>
            {{end}}
            
            {{if .NetworkInfo.IPs.EthernetIP}}
            <div class="status-item">
                <span class="status-label">Ethernet IP:</span>
                <span class="status-value">{{.NetworkInfo.IPs.EthernetIP}}</span>
            </div>
            {{end}}
        </div>
    </article>

    <article class="card">
        <h2 class="card-header">Network Mode</h2>
        <form id="mode-form" class="form-group">
            <label class="form-label" for="mode">Select Mode:</label>
            <select name="mode" id="mode" class="form-select" data-initial-mode="{{.NetworkInfo.Mode}}" onchange="handleModeChange()">
                <option value="client" {{if eq .NetworkInfo.Mode "client"}}selected{{end}}>Client Mode</option>
                <option value="ap" {{if eq .NetworkInfo.Mode "ap"}}selected{{end}}>Access Point Mode</option>
            </select>
            <button type="button" id="update-mode-btn" class="btn btn-primary btn-block mt-2" onclick="confirmModeChange()" disabled>Update Mode</button>
        </form>
        
        {{if eq .NetworkInfo.Mode "ap"}}
        {{if .ConfiguredNetworks}}
        <div class="mode-networks mt-3">
            <p class="form-label">Available Networks for Client Mode:</p>
            <p class="text-muted text-sm mb-2">At least one in-range network must have auto-connect enabled before switching to Client mode.</p>
        </div>
        {{else}}
        <p class="text-muted mt-3">No networks configured. Add networks in the section below to enable Client mode.</p>
        {{end}}
        {{end}}
        
        <p class="text-muted mt-2">Last updated: {{.Timestamp.Format "2006-01-02 15:04:05"}}</p>
    </article>
</div>
