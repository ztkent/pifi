<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PiFi - WiFi Manager</title>
    <link rel="stylesheet" href="/static/css/style.css">
    <script src="/static/js/htmx.js"></script>
</head>
<body>
    <div id="toast" class="toast hidden">
        <span id="toast-message"></span>
        <button class="toast-close" onclick="hideToast()">×</button>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirm-modal" class="modal-overlay hidden">
        <div class="modal-content">
            <h3 id="modal-title" class="modal-title">Confirm Action</h3>
            <p id="modal-message" class="modal-message"></p>
            <div class="modal-actions">
                <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
                <button id="modal-confirm-btn" class="btn btn-primary">Confirm</button>
            </div>
        </div>
    </div>

    <!-- Connection Progress Modal -->
    <div id="connection-modal" class="modal-overlay hidden">
        <div class="modal-content">
            <h3 id="connection-modal-title" class="modal-title">Connecting...</h3>
            <div id="connection-modal-body" class="modal-message">
                <div class="connection-progress">
                    <div class="spinner"></div>
                    <p>Attempting to connect to the network...</p>
                    <p class="connection-note">This may take up to 15 seconds.</p>
                </div>
            </div>
            <div id="connection-modal-actions" class="modal-actions hidden">
                <button class="btn btn-primary" onclick="closeConnectionModal()">OK</button>
            </div>
        </div>
    </div>

    <header class="app-header">
        <div class="header-content">
            <div class="header-brand">
                <a href="/" class="brand-link">PiFi</a>
            </div>
        </div>
    </header>

    <div class="app-container">
        <main class="main-content">

            <div class="content-header">
                <h1 class="page-title">Network Management</h1>
                <p class="page-subtitle">Monitor status and manage WiFi connections</p>
            </div>

            <div id="status-container">
                <div 
                    hx-get="/status" 
                    hx-trigger="load, every 30s" 
                    hx-swap="innerHTML">
                    <div class="loading-container">
                        <div class="spinner"></div>
                        <div class="loading-text">Loading status...</div>
                    </div>
                </div>
            </div>

            <div id="network-container">
                <div 
                    hx-get="/network" 
                    hx-trigger="load, networkupdate from:body" 
                    hx-swap="innerHTML">
                    <div class="loading-container">
                        <div class="spinner"></div>
                        <div class="loading-text">Loading networks...</div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function showToast(message, type) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toast-message');
            
            toast.className = 'toast';
            if (type === 'error') {
                toast.classList.add('toast-error');
            } else {
                toast.classList.add('toast-success');
            }
            
            toastMessage.textContent = message;
            
            setTimeout(() => {
                hideToast();
            }, 5000);
        }

        function hideToast() {
            document.getElementById('toast').classList.add('hidden');
        }

        // Modal functions
        function showModal(title, message, onConfirm) {
            const modal = document.getElementById('confirm-modal');
            const titleEl = document.getElementById('modal-title');
            const messageEl = document.getElementById('modal-message');
            const confirmBtn = document.getElementById('modal-confirm-btn');
            
            titleEl.textContent = title;
            messageEl.innerHTML = message;
            
            // Clone and replace to remove old listeners
            const newConfirmBtn = confirmBtn.cloneNode(true);
            confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
            newConfirmBtn.addEventListener('click', function() {
                closeModal();
                onConfirm();
            });
            
            modal.classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('confirm-modal').classList.add('hidden');
        }

        // Close modal on overlay click
        document.getElementById('confirm-modal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });

        // Close modal on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });

        // Mode change handling
        function handleModeChange() {
            const select = document.getElementById('mode');
            const btn = document.getElementById('update-mode-btn');
            if (select && btn) {
                const initialMode = select.getAttribute('data-initial-mode');
                const currentMode = select.value;
                btn.disabled = (initialMode === currentMode);
            }
        }

        function confirmModeChange() {
            const select = document.getElementById('mode');
            if (!select) return;
            
            const newMode = select.value;
            let title, message;
            
            if (newMode === 'ap') {
                title = 'Switch to Access Point Mode?';
                message = 'Switching to Access Point mode will change how you connect to this device.<br><br>' +
                    '<strong>After the switch:</strong><br>' +
                    '• Connect to the device\'s WiFi network (PiFi-AP-XXXX)<br>' +
                    '• Access this page at <strong>10.42.0.1:8088</strong><br><br>' +
                    'This page will become unavailable on the current network. Are you sure you want to continue?';
            } else {
                title = 'Switch to Client Mode?';
                message = 'Switching to Client mode will disconnect the Access Point.<br><br>' +
                    '<strong>After the switch:</strong><br>' +
                    '• The device will connect to an "auto-connect" configured WiFi network<br>' +
                    '• Access this page using the device\'s new IP address on that network<br><br>' +
                    'This page will become unavailable at the current address. Are you sure you want to continue?';
            }
            
            showModal(title, message, function() {
                // Perform the mode change
                fetch('/setmode', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'mode=' + encodeURIComponent(newMode)
                }).then(response => {
                    if (response.ok) {
                        showToast('Network mode updated. Page may become unavailable...', 'success');
                        setTimeout(() => {
                            htmx.trigger(document.body, 'networkupdate');
                        }, 1000);
                    } else {
                        response.text().then(text => {
                            showToast('Error: ' + text, 'error');
                        });
                    }
                }).catch(err => {
                    showToast('Network error: Unable to connect to server', 'error');
                });
            });
        }

        // Connection modal functions
        function showConnectionModal() {
            const modal = document.getElementById('connection-modal');
            const title = document.getElementById('connection-modal-title');
            const body = document.getElementById('connection-modal-body');
            const actions = document.getElementById('connection-modal-actions');
            
            title.textContent = 'Connecting...';
            body.innerHTML = `
                <div class="connection-progress">
                    <div class="spinner"></div>
                    <p>Attempting to connect to the network...</p>
                    <p class="connection-note">This may take up to 15 seconds.</p>
                </div>
            `;
            actions.classList.add('hidden');
            modal.classList.remove('hidden');
        }

        function showConnectionSuccess(result) {
            const title = document.getElementById('connection-modal-title');
            const body = document.getElementById('connection-modal-body');
            const actions = document.getElementById('connection-modal-actions');
            
            title.textContent = '✓ Connection Successful';
            
            let newUrl = '';
            if (result.newIP) {
                newUrl = `http://${result.newIP}:8088`;
            }
            
            body.innerHTML = `
                <div class="connection-success">
                    <p>Successfully connected to <strong>${result.newSSID}</strong></p>
                    ${result.newIP ? `<p>New IP Address: <strong>${result.newIP}</strong></p>` : ''}
                    <div class="connection-instructions">
                        <p><strong>To continue using PiFi:</strong></p>
                        <ol>
                            <li>Switch your device to the <strong>${result.newSSID}</strong> network</li>
                            ${newUrl ? `<li>Open <a href="${newUrl}" target="_blank">${newUrl}</a></li>` : '<li>Find the device\'s IP on your new network</li>'}
                        </ol>
                    </div>
                    <p class="connection-note">This page will no longer respond on the current network.</p>
                </div>
            `;
            actions.classList.remove('hidden');
        }

        function showConnectionFailure(result) {
            const title = document.getElementById('connection-modal-title');
            const body = document.getElementById('connection-modal-body');
            const actions = document.getElementById('connection-modal-actions');
            
            title.textContent = '✗ Connection Failed';
            
            let fallbackMsg = '';
            if (result.fallbackUsed && result.fallbackSSID) {
                fallbackMsg = `<p class="connection-fallback-success">✓ Restored connection to <strong>${result.fallbackSSID}</strong></p>`;
            } else if (result.fallbackSSID) {
                fallbackMsg = `<p class="connection-fallback-failed">⚠ Could not restore previous connection to ${result.fallbackSSID}</p>`;
            }
            
            body.innerHTML = `
                <div class="connection-failure">
                    <p class="connection-error-message">${result.errorMessage || 'Failed to connect to the network.'}</p>
                    ${fallbackMsg}
                    <div class="connection-instructions">
                        <p><strong>Possible solutions:</strong></p>
                        <ul>
                            ${result.errorType === 'wrong_password' ? '<li>Check that the password is correct</li>' : ''}
                            ${result.errorType === 'network_not_found' ? '<li>Make sure the network is in range</li><li>Check that the network name is correct</li>' : ''}
                            ${result.errorType === 'timeout' ? '<li>Move closer to the network</li><li>Check that the password is correct</li>' : ''}
                            <li>Try scanning for networks again</li>
                        </ul>
                    </div>
                </div>
            `;
            actions.classList.remove('hidden');
        }

        // Poll to check if server is still reachable after network error
        // If reachable, fallback happened (failure). If not, success (server moved).
        async function checkConnectionOutcome(ssid) {
            const title = document.getElementById('connection-modal-title');
            const body = document.getElementById('connection-modal-body');
            
            title.textContent = 'Checking connection...';
            body.innerHTML = `
                <div class="connection-progress">
                    <div class="spinner"></div>
                    <p>Verifying connection status...</p>
                    <p class="connection-note">Please wait while we check the result.</p>
                </div>
            `;
            
            // Wait for fallback to complete (up to 12 seconds with retries)
            const maxAttempts = 6;
            const delayMs = 2000;
            
            for (let i = 0; i < maxAttempts; i++) {
                await new Promise(resolve => setTimeout(resolve, delayMs));
                
                try {
                    // Add timeout to polling requests
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 3000); // 3 second timeout per attempt
                    
                    const response = await fetch('/api/status', { 
                        method: 'GET',
                        cache: 'no-store',
                        signal: controller.signal
                    });
                    
                    clearTimeout(timeoutId);
                    
                    if (response.ok) {
                        const data = await response.json();
                        // Server is reachable - fallback happened, connection failed
                        const currentSSID = data.data?.WifiSSID || '';
                        showConnectionFailure({
                            errorType: 'timeout',
                            errorMessage: 'Connection to ' + ssid + ' failed.',
                            fallbackSSID: currentSSID,
                            fallbackUsed: true
                        });
                        return;
                    }
                } catch (e) {
                    // Server not reachable (timeout or network error) - might be on new network
                    // Continue checking in case it's just slow
                }
            }
            
            // After all attempts, server is not reachable - assume success
            showConnectionSuccess({ 
                newSSID: ssid, 
                newIP: '' 
            });
        }

        function closeConnectionModal() {
            document.getElementById('connection-modal').classList.add('hidden');
            htmx.trigger(document.body, 'networkupdate');
        }

        // Network connect confirmation
        function confirmNetworkConnect(ssid) {
            const title = 'Connect to Network?';
            const message = 'Connecting to <strong>' + ssid + '</strong> will attempt to join the new network.<br><br>' +
                '<strong>What happens:</strong><br>' +
                '• The device will try to connect (up to 15 seconds)<br>' +
                '• If successful, you\'ll need to switch networks to access this page<br>' +
                '• If it fails, the current connection will be restored<br><br>' +
                'Continue?';
            
            showModal(title, message, function() {
                // Show progress modal
                showConnectionModal();
                
                // Create abort controller for timeout
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 15000); // 15 second timeout
                
                // Perform the connection via API
                fetch('/api/networks/connect', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ ssid: ssid }),
                    signal: controller.signal
                }).then(response => {
                    clearTimeout(timeoutId);
                    return response.json();
                })
                .then(data => {
                    if (data.success && data.data && data.data.success) {
                        showConnectionSuccess(data.data);
                    } else {
                        showConnectionFailure(data.data || { errorMessage: data.error || 'Unknown error' });
                    }
                }).catch(err => {
                    clearTimeout(timeoutId);
                    // Network error or timeout - need to determine outcome
                    // Poll to check if server is still reachable (fallback) or not (success)
                    checkConnectionOutcome(ssid);
                });
            });
        }

        document.body.addEventListener('htmx:afterRequest', function(event) {
            const detail = event.detail;
            const path = detail.pathInfo.requestPath;
            
            if (detail.successful) {
                if (path === '/add-network') {
                    showToast('Network configured successfully', 'success');
                    htmx.trigger(document.body, 'networkupdate');
                } else if (path === '/remove-network') {
                    showToast('Network removed', 'success');
                    htmx.trigger(document.body, 'networkupdate');
                } else if (path === '/autoconnect-network') {
                    showToast('Auto-connect settings updated', 'success');
                    htmx.trigger(document.body, 'networkupdate');
                }
            }
        });

        document.body.addEventListener('htmx:responseError', function(event) {
            const errorMsg = event.detail.xhr.responseText || 'An error occurred';
            showToast('Error: ' + errorMsg, 'error');
        });

        document.body.addEventListener('htmx:sendError', function(event) {
            showToast('Network error: Unable to connect to server', 'error');
        });

        document.addEventListener('click', function(event) {
            const sidebar = document.getElementById('sidebar');
            const menuBtn = document.querySelector('.mobile-menu-btn');
            
            if (window.innerWidth <= 768 && 
                sidebar.classList.contains('open') && 
                !sidebar.contains(event.target) && 
                event.target !== menuBtn) {
                sidebar.classList.remove('open');
            }
        });
    </script>
</body>
</html>
