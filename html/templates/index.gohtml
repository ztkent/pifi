<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PiFi - WiFi Manager</title>
    <link rel="stylesheet" href="/static/css/style.css">
    <script src="/static/js/htmx.js"></script>
</head>
<body>
    <div id="toast" class="toast hidden">
        <span id="toast-message"></span>
        <button class="toast-close" onclick="hideToast()">×</button>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirm-modal" class="modal-overlay hidden">
        <div class="modal-content">
            <h3 id="modal-title" class="modal-title">Confirm Action</h3>
            <p id="modal-message" class="modal-message"></p>
            <div class="modal-actions">
                <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
                <button id="modal-confirm-btn" class="btn btn-primary">Confirm</button>
            </div>
        </div>
    </div>

    <header class="app-header">
        <div class="header-content">
            <div class="header-brand">
                <a href="/" class="brand-link">PiFi</a>
            </div>
        </div>
    </header>

    <div class="app-container">
        <main class="main-content">

            <div class="content-header">
                <h1 class="page-title">Network Management</h1>
                <p class="page-subtitle">Monitor status and manage WiFi connections</p>
            </div>

            <div id="status-container">
                <div 
                    hx-get="/status" 
                    hx-trigger="load, every 30s" 
                    hx-swap="innerHTML">
                    <div class="loading-container">
                        <div class="spinner"></div>
                        <div class="loading-text">Loading status...</div>
                    </div>
                </div>
            </div>

            <div id="network-container">
                <div 
                    hx-get="/network" 
                    hx-trigger="load, networkupdate from:body" 
                    hx-swap="innerHTML">
                    <div class="loading-container">
                        <div class="spinner"></div>
                        <div class="loading-text">Loading networks...</div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function showToast(message, type) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toast-message');
            
            toast.className = 'toast';
            if (type === 'error') {
                toast.classList.add('toast-error');
            } else {
                toast.classList.add('toast-success');
            }
            
            toastMessage.textContent = message;
            
            setTimeout(() => {
                hideToast();
            }, 5000);
        }

        function hideToast() {
            document.getElementById('toast').classList.add('hidden');
        }

        // Modal functions
        function showModal(title, message, onConfirm) {
            const modal = document.getElementById('confirm-modal');
            const titleEl = document.getElementById('modal-title');
            const messageEl = document.getElementById('modal-message');
            const confirmBtn = document.getElementById('modal-confirm-btn');
            
            titleEl.textContent = title;
            messageEl.innerHTML = message;
            
            // Clone and replace to remove old listeners
            const newConfirmBtn = confirmBtn.cloneNode(true);
            confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
            newConfirmBtn.addEventListener('click', function() {
                closeModal();
                onConfirm();
            });
            
            modal.classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('confirm-modal').classList.add('hidden');
        }

        // Close modal on overlay click
        document.getElementById('confirm-modal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });

        // Close modal on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });

        // Mode change handling
        function handleModeChange() {
            const select = document.getElementById('mode');
            const btn = document.getElementById('update-mode-btn');
            if (select && btn) {
                const initialMode = select.getAttribute('data-initial-mode');
                const currentMode = select.value;
                btn.disabled = (initialMode === currentMode);
            }
        }

        function confirmModeChange() {
            const select = document.getElementById('mode');
            if (!select) return;
            
            const newMode = select.value;
            let title, message;
            
            if (newMode === 'ap') {
                title = 'Switch to Access Point Mode?';
                message = 'Switching to Access Point mode will change how you connect to this device.<br><br>' +
                    '<strong>After the switch:</strong><br>' +
                    '• Connect to the device\'s WiFi network (PiFi-AP-XXXX)<br>' +
                    '• Access this page at <strong>10.42.0.1:8088</strong><br><br>' +
                    'This page will become unavailable on the current network. Are you sure you want to continue?';
            } else {
                title = 'Switch to Client Mode?';
                message = 'Switching to Client mode will disconnect the Access Point.<br><br>' +
                    '<strong>After the switch:</strong><br>' +
                    '• The device will connect to an "auto-connect" configured WiFi network<br>' +
                    '• Access this page using the device\'s new IP address on that network<br><br>' +
                    'This page will become unavailable at the current address. Are you sure you want to continue?';
            }
            
            showModal(title, message, function() {
                // Perform the mode change
                fetch('/setmode', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'mode=' + encodeURIComponent(newMode)
                }).then(response => {
                    if (response.ok) {
                        showToast('Network mode updated. Page may become unavailable...', 'success');
                        setTimeout(() => {
                            htmx.trigger(document.body, 'networkupdate');
                        }, 1000);
                    } else {
                        response.text().then(text => {
                            showToast('Error: ' + text, 'error');
                        });
                    }
                }).catch(err => {
                    showToast('Network error: Unable to connect to server', 'error');
                });
            });
        }

        // Network connect confirmation
        function confirmNetworkConnect(ssid) {
            const title = 'Connect to Network?';
            const message = 'Connecting to <strong>' + ssid + '</strong> will disconnect you from the current network.<br><br>' +
                '<strong>After connecting:</strong><br>' +
                '• The device will attempt to join the new network<br>' +
                '• Access this page using the device\'s new IP address on that network<br><br>' +
                'This page will become unavailable. Are you sure you want to continue?';
            
            showModal(title, message, function() {
                // Perform the connection
                fetch('/connect', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'network=' + encodeURIComponent(ssid)
                }).then(response => {
                    if (response.ok) {
                        showToast('Connecting to ' + ssid + '. Page may become unavailable...', 'success');
                        setTimeout(() => {
                            htmx.trigger(document.body, 'networkupdate');
                        }, 1000);
                    } else {
                        response.text().then(text => {
                            showToast('Error: ' + text, 'error');
                        });
                    }
                }).catch(err => {
                    showToast('Network error: Unable to connect to server', 'error');
                });
            });
        }

        document.body.addEventListener('htmx:afterRequest', function(event) {
            const detail = event.detail;
            const path = detail.pathInfo.requestPath;
            
            if (detail.successful) {
                if (path === '/add-network') {
                    showToast('Network configured successfully', 'success');
                    htmx.trigger(document.body, 'networkupdate');
                } else if (path === '/remove-network') {
                    showToast('Network removed', 'success');
                    htmx.trigger(document.body, 'networkupdate');
                } else if (path === '/autoconnect-network') {
                    showToast('Auto-connect settings updated', 'success');
                    htmx.trigger(document.body, 'networkupdate');
                }
            }
        });

        document.body.addEventListener('htmx:responseError', function(event) {
            const errorMsg = event.detail.xhr.responseText || 'An error occurred';
            showToast('Error: ' + errorMsg, 'error');
        });

        document.body.addEventListener('htmx:sendError', function(event) {
            showToast('Network error: Unable to connect to server', 'error');
        });

        document.addEventListener('click', function(event) {
            const sidebar = document.getElementById('sidebar');
            const menuBtn = document.querySelector('.mobile-menu-btn');
            
            if (window.innerWidth <= 768 && 
                sidebar.classList.contains('open') && 
                !sidebar.contains(event.target) && 
                event.target !== menuBtn) {
                sidebar.classList.remove('open');
            }
        });
    </script>
</body>
</html>
