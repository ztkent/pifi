<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PiFi - WiFi Manager</title>
    <link rel="stylesheet" href="/static/css/style.css">
    <script src="/static/js/htmx.js"></script>
</head>
<body>
    <div id="toast" class="toast hidden">
        <span id="toast-message"></span>
        <button class="toast-close" onclick="hideToast()">×</button>
    </div>

    <header class="app-header">
        <div class="header-content">
            <div class="header-brand">
                <a href="/" class="brand-link">PiFi</a>
            </div>
        </div>
    </header>

    <div class="app-container">
        <main class="main-content">

            <div class="content-header">
                <h1 class="page-title">Network Management</h1>
                <p class="page-subtitle">Monitor status and manage WiFi connections</p>
            </div>

            <div id="status-container">
                <div 
                    hx-get="/status" 
                    hx-trigger="load, every 30s" 
                    hx-swap="innerHTML">
                    <div class="loading-container">
                        <div class="spinner"></div>
                        <div class="loading-text">Loading status...</div>
                    </div>
                </div>
            </div>

            <div id="network-container">
                <div 
                    hx-get="/network" 
                    hx-trigger="load, networkupdate from:body" 
                    hx-swap="innerHTML">
                    <div class="loading-container">
                        <div class="spinner"></div>
                        <div class="loading-text">Loading networks...</div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function showToast(message, type) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toast-message');
            
            toast.className = 'toast';
            if (type === 'error') {
                toast.classList.add('toast-error');
            } else {
                toast.classList.add('toast-success');
            }
            
            toastMessage.textContent = message;
            
            setTimeout(() => {
                hideToast();
            }, 5000);
        }

        function hideToast() {
            document.getElementById('toast').classList.add('hidden');
        }

        document.body.addEventListener('htmx:afterRequest', function(event) {
            const detail = event.detail;
            const path = detail.pathInfo.requestPath;
            
            if (detail.successful) {
                if (path === '/add-network') {
                    showToast('Network configured successfully', 'success');
                    htmx.trigger(document.body, 'networkupdate');
                } else if (path === '/remove-network') {
                    showToast('Network removed', 'success');
                    htmx.trigger(document.body, 'networkupdate');
                } else if (path === '/connect') {
                    showToast('Connected to network', 'success');
                    htmx.trigger(document.body, 'networkupdate');
                } else if (path === '/autoconnect-network') {
                    showToast('Auto-connect settings updated', 'success');
                    htmx.trigger(document.body, 'networkupdate');
                } else if (path === '/setmode') {
                    showToast('Network mode updated', 'success');
                    setTimeout(() => {
                        htmx.trigger(document.body, 'networkupdate');
                    }, 1000);
                }
            }
        });

        document.body.addEventListener('htmx:responseError', function(event) {
            const errorMsg = event.detail.xhr.responseText || 'An error occurred';
            showToast('Error: ' + errorMsg, 'error');
        });

        document.body.addEventListener('htmx:sendError', function(event) {
            showToast('Network error: Unable to connect to server', 'error');
        });

        document.addEventListener('click', function(event) {
            const sidebar = document.getElementById('sidebar');
            const menuBtn = document.querySelector('.mobile-menu-btn');
            
            if (window.innerWidth <= 768 && 
                sidebar.classList.contains('open') && 
                !sidebar.contains(event.target) && 
                event.target !== menuBtn) {
                sidebar.classList.remove('open');
            }
        });
    </script>
</body>
</html>
