<div class="card-grid">
    <article class="card">
        {{if .ConfiguredNetworks}}
        <h2 class="card-header" style="cursor: pointer;" onclick="toggleSection('configured-networks')">
            <span id="configured-icon">▼</span> Configured Networks
        </h2>
        <div class="network-list" id="configured-networks">
            {{range .ConfiguredNetworks}}
            {{$ssid := .SSID}}
            {{$autoConnect := .AutoConnect}}
            <div class="network-item">
                <div class="network-item-header">
                    <span class="network-name">{{.SSID}}</span>
                    <div>
                        {{if eq $.CurrentSSID .SSID}}
                        <span class="network-badge badge-connected">Connected</span>
                        <span class="network-badge badge-active">Active</span>
                        {{else}}
                        <span class="network-badge badge-configured">Configured</span>
                        {{range $.AvailableNetworks}}
                        {{if eq . $ssid}}
                        <span class="network-badge badge-available">Available</span>
                        {{end}}
                        {{end}}
                        {{end}}
                        {{if $autoConnect}}
                        <span class="network-badge badge-autoconnect">Auto</span>
                        {{end}}
                    </div>
                </div>
                <div class="network-actions">
                    <div class="network-actions-left">
                        {{if ne $.CurrentSSID .SSID}}
                        <button 
                            class="btn btn-primary btn-sm"
                            onclick="confirmNetworkConnect('{{.SSID}}')">
                            Connect
                        </button>
                        <button 
                            class="btn btn-danger btn-sm"
                            hx-post="/remove-network"
                            hx-vals='{"network": "{{.SSID}}"}'
                            hx-swap="none"
                            hx-confirm="Are you sure you want to remove this network?">
                            Remove
                        </button>
                        {{else}}
                        <button 
                            class="btn btn-danger btn-sm"
                            disabled
                            title="Cannot remove the active connection">
                            Remove
                        </button>
                        {{end}}
                    </div>
                    <div class="toggle-with-label">
                        <span class="toggle-label">Auto</span>
                        <label class="toggle-switch" title="Auto-connect">
                            <input type="checkbox" 
                                {{if $autoConnect}}checked{{end}}
                                hx-post="/autoconnect-network"
                                hx-vals='{"network": "{{.SSID}}", "autoconnect": "{{if $autoConnect}}false{{else}}true{{end}}"}'
                                hx-swap="none">
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>
            </div>
            {{end}}
        </div>
        {{end}}
    </article>

    <article class="card">
        <h2 class="card-header">Add New Network</h2>
        <form hx-post="/add-network" hx-swap="none">
            <div class="form-group">
                <label class="form-label" for="ssid">Network Name (SSID):</label>
                {{if .AvailableNetworks}}
                <select name="ssid" id="ssid" class="form-select" onchange="togglePasswordField()">
                    <option value="">Select a network...</option>
                    {{range .AvailableNetworks}}
                    <option value="{{.}}">{{.}}</option>
                    {{end}}
                    <option value="__custom__">Enter custom SSID...</option>
                </select>
                
                <input 
                    type="text" 
                    name="ssid_custom" 
                    id="ssid_custom" 
                    class="form-input mt-2 hidden" 
                    placeholder="Enter network name">
                {{else}}
                <input 
                    type="text" 
                    name="ssid" 
                    id="ssid" 
                    class="form-input" 
                    placeholder="Enter network name" 
                    required>
                {{end}}
            </div>
            
            <div class="form-group" id="passwordField">
                <label class="form-label" for="password">Password:</label>
                <input 
                    type="password" 
                    name="password" 
                    id="password" 
                    class="form-input" 
                    placeholder="Enter password">
                <p class="text-muted mt-1">Leave blank for open networks</p>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" name="autoconnect" value="true" checked>
                    <span>Auto-connect when in range</span>
                </label>
            </div>
            
            <button type="submit" class="btn btn-primary btn-block">Add Network</button>
        </form>
    </article>
</div>

<script>
function togglePasswordField() {
    const select = document.getElementById('ssid');
    const customInput = document.getElementById('ssid_custom');
    
    if (select && customInput) {
        if (select.value === '__custom__') {
            customInput.classList.remove('hidden');
            customInput.required = true;
            select.removeAttribute('name');
        } else {
            customInput.classList.add('hidden');
            customInput.required = false;
            select.setAttribute('name', 'ssid');
        }
    }
}

function toggleSection(sectionId) {
    const section = document.getElementById(sectionId);
    const icon = document.getElementById('configured-icon');
    
    if (section) {
        section.classList.toggle('hidden');
        if (icon) {
            icon.textContent = section.classList.contains('hidden') ? '▶' : '▼';
        }
    }
}
</script>
